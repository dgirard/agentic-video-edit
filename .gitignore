# Charte / design system propriétaire (SFEIR) — local uniquement
/design-system/
!/design-system/.gitkeep

# Médias : rushes sources + rendus (lourds + privés)
/media/
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3
*.MP4
*.MOV

# Artefacts dérivés de la vidéo privée (contiennent le contenu parlé)
/work/transcripts/*.json
/work/final-edit.json
/work/overlay-timings.json
/graphics/src/timings.json
/graphics/src/brand.json
/graphics/src/agenda.json
/graphics/public/
!/work/transcripts/.gitkeep

# ─────────────────────────────────────────────────────────────
